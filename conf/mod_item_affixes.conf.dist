#############################################
# mod-item-affixes (Conquest of Azeroth)
#
# Green-or-better weapons and armor roll random stat affixes the moment a player receives them
# (loot, quest reward, crafting, vendor). Affixes follow the receiver's active specialization:
# role (caster/physical/ranged/tank/healer) and primary attributes come from ChrSpecs.dbc.
# Tooltips need the ItemAffixes client addon.
#############################################

[worldserver]

#
#    ItemAffixes.Enable
#        Description: Master switch. 0 = no rolling, no stats applied, addon requests ignored.
#        Default:     1
#

ItemAffixes.Enable = 1

#
#    ItemAffixes.ExcludeBots
#        Description: Playerbots never roll or apply affixes.
#        Default:     1
#

ItemAffixes.ExcludeBots = 1

#
#    ItemAffixes.RollUnrolledOnEquip
#        Description: Equipping (and logging in with) an eligible item that has never been rolled
#                     rolls it for the wearer. Covers mail, auction, trade and gear from before
#                     the module was installed.
#        Default:     1
#

ItemAffixes.RollUnrolledOnEquip = 1

#
#    ItemAffixes.SlotCountGreen / Blue / Purple / Legendary
#        Description: Affix slots per item quality (0-6). Grey and white items never roll.
#        Default:     1 / 2 / 3 / 4
#

ItemAffixes.SlotCountGreen     = 1
ItemAffixes.SlotCountBlue      = 2
ItemAffixes.SlotCountPurple    = 3
ItemAffixes.SlotCountLegendary = 4

#
#    ItemAffixes.TwoHanderBonusSlots
#        Description: Extra slots for two-handed weapons. Their values are also 1.5x.
#        Default:     1
#

ItemAffixes.TwoHanderBonusSlots = 1

#
#    ItemAffixes.BonusSlotChance
#        Description: Chance (percent) that an item gets one extra affix slot, rolled once when
#                     the item gets its first affixes (loot, quest reward, craft, purchase, or
#                     first equip of an unrolled item). The extra slot rolls like every other
#                     (stat or skill affix, at most one skill affix per item); total at most 6.
#                     Items that already have affixes never gain one.
#        Default:     5
#

ItemAffixes.BonusSlotChance = 5

#
#    ItemAffixes.BudgetFractionGreen / Blue / Purple / Legendary
#        Description: Share of the item's stat budget one affix gets.
#                     value = budget(iLvl) * slot modifier * fraction * StatMultiplier
#        Default:     0.18 / 0.13 / 0.10 / 0.09
#

ItemAffixes.BudgetFractionGreen     = 0.18
ItemAffixes.BudgetFractionBlue      = 0.13
ItemAffixes.BudgetFractionPurple    = 0.10
ItemAffixes.BudgetFractionLegendary = 0.09

#
#    ItemAffixes.StatMultiplier
#        Description: Global scale of every affix value.
#        Default:     1.5
#

ItemAffixes.StatMultiplier = 1.5

#
#    ItemAffixes.BudgetMinRoll
#        Description: Lowest roll as a fraction of the maximum (1.0 = always the maximum).
#        Default:     0.75
#

ItemAffixes.BudgetMinRoll = 0.75

#
#    ItemAffixes.MaxBudgetItemLevel
#        Description: Item level used for the budget is capped here, so test and custom items
#                     with item level 200+ do not roll WotLK-sized values. 0 = no cap.
#        Default:     100
#

ItemAffixes.MaxBudgetItemLevel = 100

#
#    ItemAffixes.SecondaryAttributeWeightPct
#        Description: Weight (percent of the affix weight) of an attribute the specialization
#                     lists but which is not its main stat, and of Spirit for healers.
#                     Attributes the specialization does not list never roll.
#        Default:     33
#

ItemAffixes.SecondaryAttributeWeightPct = 33

#
#    ItemAffixes.EnableCritRolls
#    ItemAffixes.CritRollChance
#        Description: Chance (percent per affix, also per Reforge option) for a 1.5x value,
#                     shown in gold.
#        Default:     1 / 10
#

ItemAffixes.EnableCritRolls = 1
ItemAffixes.CritRollChance  = 10

#
#    ItemAffixes.SkillAffixes.Enable
#        Description: CoA class skill affixes (spell modifiers on one class ability, e.g.
#                     "Glacial Tap: -1.5 sec cooldown"). Needs
#                     data/sql/db-world/mod_item_affixes_template_skill.sql (affix_template skill
#                     rows, affix_skill_target and carrier spell 9979001 in spell_dbc). 0 = rolled
#                     skill affixes stay on items but neither roll nor apply.
#                     Every affix is a server-side SpellModifier (targetSpellId, cooldown via
#                     SPELLMOD_COOLDOWN) and is shown in the client by sending the player a
#                     modified Spell row (SMSG_PATCH_SPELL) for every affected spell: cooldown,
#                     cost, effect base points and jump targets exactly; cast time, duration,
#                     radius and range rounded to an existing SpellCastTimes / SpellDuration /
#                     SpellRadius / SpellRange row (range never above the server's); other
#                     effects (damage %, crit, DoT, ...) as an "Affixes:" line in the
#                     description. The original row is sent when an affix goes, at login and
#                     after a spec change. Needs the core patch core-ascension-spell-row-api and
#                     CoA.SendDisplayPatches = 1. Bots never get rows.
#                     The former ItemAffixes.SkillAffixes.StreamSpellRows is gone (streaming is
#                     the only mode); if still set it is ignored with a warning at startup.
#        Default:     1
#

ItemAffixes.SkillAffixes.Enable = 1

#
#    ItemAffixes.SkillAffixChance
#        Description: Chance (percent) that a newly rolled blue, epic or legendary item of a
#                     CoA class (12-32) gets one class skill affix in its first new line, picked
#                     by weight among the affixes of the receiver's class (all specializations)
#                     whose min_quality the item meets and whose spell the receiver knows. At
#                     most one skill affix per item. A Reforge option of a stat line uses the
#                     same chance; a skill line always reforges into skill affixes. A crit roll
#                     (CritRollChance) gives 1.5x only for affixes with scales_with_crit.
#                     (The live server overrides this to 40; the default stays 20.)
#        Default:     20
#

ItemAffixes.SkillAffixChance = 20

#
#    ItemAffixes.SummonAffixes.Enable
#        Description: Summon affixes: "+X% Summon Damage", "+X% Summon Health" and "+X% Summon
#                     Attack Speed" for every creature the player owns (pets, guardians, minions,
#                     totems, turrets). They are stat affixes (affix_template stat_op 23, 24, 26
#                     from data/sql/db-world/mod_item_affixes_template_summon.sql) and roll in the
#                     stat pool only for the specializations in ItemAffixes.SummonAffixes.Specs,
#                     at most one per item; value from the item budget like other stats.
#                     Damage: melee, spell and periodic damage of the summon, scaled by script
#                     hooks. Health and attack speed: hidden carrier aura 9979002 (spell_dbc) on
#                     each summon, set when it appears and after equipment changes (summons
#                     within 250 yards). 0 = summon affixes stay on items but neither roll nor apply.
#        Default:     1
#

ItemAffixes.SummonAffixes.Enable = 1

#
#    ItemAffixes.SummonAffixes.Specs
#        Description: Comma-separated ChrSpecs ids whose players roll summon affixes
#                     (".affix spec" shows the id). Default: Witch Hunter Houndmaster (11),
#                     Fleshwarden Defiance (17), Necromancer Animation (35) and Rime (36), Tinker
#                     Mechanics (50), Hunter Beast Mastery (70), Death Knight Unholy (81),
#                     Warlock Demonology (90).
#        Default:     "11,17,35,36,50,70,81,90"
#

ItemAffixes.SummonAffixes.Specs = "11,17,35,36,50,70,81,90"

#
#    ItemAffixes.SummonAffixes.CapPct
#        Description: Upper limit (percent) of each summed summon stat (damage, health, attack
#                     speed) across all equipped items.
#        Default:     100
#

ItemAffixes.SummonAffixes.CapPct = 100

#
#    ItemAffixes.ReforgeOptionsGreen / Blue / Purple / Legendary
#        Description: New options a Reforge shows next to the current value (1-6).
#        Default:     1 / 2 / 3 / 4
#

ItemAffixes.ReforgeOptionsGreen     = 1
ItemAffixes.ReforgeOptionsBlue      = 2
ItemAffixes.ReforgeOptionsPurple    = 3
ItemAffixes.ReforgeOptionsLegendary = 4

#
#    ItemAffixes.ReforgeBaseCostGreen / Blue / Purple / Legendary
#    ItemAffixes.ReforgeReferenceItemLevel
#    ItemAffixes.ReforgeCostIncreasePct
#        Description: Reforge cost in copper:
#                     base * item level / ReforgeReferenceItemLevel
#                          * (1 + times already reforged * ReforgeCostIncreasePct / 100).
#                     The item level is capped by MaxBudgetItemLevel. ReforgeReferenceItemLevel 0 =
#                     no item level scaling (the base is the price). Minimum 1 copper.
#        Default:     5000 / 20000 / 75000 / 250000, 60, 50
#

ItemAffixes.ReforgeBaseCostGreen     = 5000
ItemAffixes.ReforgeBaseCostBlue      = 20000
ItemAffixes.ReforgeBaseCostPurple    = 75000
ItemAffixes.ReforgeBaseCostLegendary = 250000
ItemAffixes.ReforgeReferenceItemLevel = 60
ItemAffixes.ReforgeCostIncreasePct    = 50
